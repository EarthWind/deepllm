import torch
from reasoning_from_scratch.ch02 import get_device
from reasoning_from_scratch.qwen3 import (
    download_qwen3_small, Qwen3Tokenizer,
    Qwen3Model, QWEN_CONFIG_06_B
)

device =3D get_device()

# Set matmul precision to "high" to=20
# enable Tensor Cores on compatible GPUs
torch.set_float32_matmul_precision("high")

# Uncomment the following line=20
# if you encounter device compatibility issues
# device =3D "cpu"

# Use the base model by default
WHICH_MODEL =3D "base"

if WHICH_MODEL =3D=3D "base":
    download_qwen3_small(
        kind=3D"base", tokenizer_only=3DFalse, out_dir=3D"qwen3"
    )
    tokenizer_path =3D Path("qwen3") / "tokenizer-base.json"
    model_path =3D Path("qwen3") / "qwen3-0.6B-base.pth"
    tokenizer =3D Qwen3Tokenizer(tokenizer_file_path=3Dtokenizer_path)

elif WHICH_MODEL =3D=3D "reasoning":
    download_qwen3_small(
        kind=3D"reasoning", tokenizer_only=3DFalse, out_dir=3D"qwen3"
    )
    tokenizer_path =3D Path("qwen3") / "tokenizer-reasoning.json"
    model_path =3D Path("qwen3") / "qwen3-0.6B-reasoning.pth"
    tokenizer =3D Qwen3Tokenizer(
        tokenizer_file_path=3Dtokenizer_path,
        apply_chat_template=3DTrue,
        add_generation_prompt=3DTrue,
        add_thinking=3DTrue,
    )

else:
    raise ValueError(f"Invalid choice: WHICH_MODEL=3D{WHICH_MODEL}")

model =3D Qwen3Model(QWEN_CONFIG_06_B)
model.load_state_dict(torch.load(model_path))
model.to(device)

# Optionally enable model compilation for potential performance gains
USE_COMPILE =3D False
if USE_COMPILE:
    torch._dynamo.config.allow_unspec_int_on_nn_module =3D True
    model =3D torch.compile(model)</code></pre><p></p><h2 class=3D"header-a=

om reasoning_from_scratch.ch02_ex import (
    generate_text_basic_stream_cache
)

def predict_choice(
    model, tokenizer, prompt_fmt, max_new_tokens=3D8
):
    pred =3D None
    for t in generate_text_basic_stream_cache(
        model=3Dmodel,
        token_ids=3Dprompt_fmt,
        max_new_tokens=3Dmax_new_tokens,
        eos_token_id=3Dtokenizer.eos_token_id,
    ):
        answer =3D tokenizer.decode(t.squeeze(0).tolist())
        for letter in answer:
            letter =3D letter.upper()
            # stop as soon as a letter appears
            if letter in "ABCD":
                pred =3D letter
                break
        if pred:
            break
    return pred</code></pre><p>We can then check the generated letter using=

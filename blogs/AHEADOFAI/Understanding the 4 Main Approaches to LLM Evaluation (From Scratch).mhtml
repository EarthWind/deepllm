import urllib.request


def query_model(
    prompt,
    model=3D"gpt-oss:20b",
    # If you used=20
    # OLLAMA_HOST=3D127.0.0.1:11435 ollama serve
    # update the address below
    url=3D"http://localhost:11434/api/chat"
):
    # Create the data payload as a dictionary:
    data =3D {
        "model": model,
        "messages": [
            {"role": "user", "content": prompt}
        ],
        # Settings required for deterministic responses:
        "options": {
            "seed": 123,
            "temperature": 0,
            "num_ctx": 2048
        }
    }

    # Convert the dictionary to JSON and encode it to bytes
    payload =3D json.dumps(data).encode("utf-8")

    # Create a POST request and add headers
    request =3D urllib.request.Request( =20
        url,
        data=3Dpayload,
        method=3D"POST"
    )
    request.add_header("Content-Type", "application/json")

    response_data =3D ""

    # Send the request and capture the streaming response
    with urllib.request.urlopen(request) as response:
        while True:
            line =3D response.readline().decode("utf-8")
            if not line:
                break
            # Parse each line into JSON
            response_json =3D json.loads(line)
            response_data +=3D response_json["message"]["content"]

    return response_data</code></pre><p><span>Here=E2=80=99s an example of =

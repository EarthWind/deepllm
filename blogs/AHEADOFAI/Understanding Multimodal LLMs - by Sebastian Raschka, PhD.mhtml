/figure></div><p>For those who prefer seeing a code example, In PyTorch cod=
e, we could implement the linear projection for the image patches as follow=
s:</p><pre><code>import torch


class PatchProjectionLayer(torch.nn.Module):

&nbsp;&nbsp;&nbsp;&nbsp;def __init__(self, patch_size, num_channels, embedd=
ing_dim):
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;super().__init__()
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.patch_size =3D patch_s=
ize
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.num_channels =3D num_c=
hannels
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.embedding_dim =3D embe=
dding_dim
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;self.projection =3D torch.n=
n.Linear(
            patch_size * patch_size * num_channels, embedding_dim
        )

&nbsp;&nbsp;&nbsp;&nbsp;def forward(self, x):

&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;batch_size, num_patches, ch=
annels, height, width =3D x.size()
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x =3D x.view(batch_size, nu=
m_patches, -1)&nbsp; # Flatten each patch
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x =3D self.projection(x)&nb=
sp; # Project each flattened patch
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return x


# Example Usage:
batch_size =3D 1
num_patches =3D 9&nbsp; # Total patches per image
patch_size =3D 16&nbsp; # 16x16 pixels per patch
num_channels =3D 3&nbsp; # RGB image
embedding_dim =3D 768&nbsp; # Size of the embedding vector

projection_layer =3D PatchProjectionLayer(patch_size, num_channels, embeddi=
ng_dim)

patches =3D torch.rand(
    batch_size, num_patches, num_channels, patch_size, patch_size
)

projected_embeddings =3D projection_layer(patches)
print(projected_embeddings.shape)

# This prints
# torch.Size([1, 9, 768])</code></pre><p><span>If you have read my </span><=
